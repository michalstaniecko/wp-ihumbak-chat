{
    "name": "michalstaniecko/wp-ihumbak-chat",
    "description": "A floating chat widget for quick admin communication in WordPress",
    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "plugin",
        "chat",
        "contact",
        "widget"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Michał Staniecko",
            "homepage": "https://github.com/michalstaniecko"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "wp-coding-standards/wpcs": "^2.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "scripts": {
        "phpcs": "phpcs --standard=WordPress includes/ admin/",
        "phpcbf": "phpcbf --standard=WordPress includes/ admin/",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
