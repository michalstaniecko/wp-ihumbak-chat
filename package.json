  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "clean-css-cli": "^5.6.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/michalstaniecko/wp-ihumbak-chat"
  },
  "bugs": {
    "url": "https://github.com/michalstaniecko/wp-ihumbak-chat/issues"
  },
  "homepage": "https://github.com/michalstaniecko/wp-ihumbak-chat#readme"
