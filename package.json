{
  "name": "wp-ihumbak-chat",
  "version": "1.0.0",
  "description": "A floating chat widget for quick admin communication in WordPress",
  "main": "public/js/ihumbak-widget.js",
  "scripts": {
    "dev": "tailwindcss -i public/css/input.css -o public/css/ihumbak-widget.css --watch",
    "build": "tailwindcss -i public/css/input.css -o public/css/ihumbak-widget.css --minify",
    "watch": "npm run dev",
    "test": "echo \"No tests configured yet\" && exit 0"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "chat",
    "widget",
    "contact-form"
  ],
